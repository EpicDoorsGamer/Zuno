DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_client_id_here

# Optional: set this for instant guild-only command deployment while testing.
# Leave empty to deploy commands globally.
DISCORD_GUILD_ID=

# Optional: Roblox group/clan ID checked in the CLAN section.
ROBLOX_GROUP_ID=

# Discord role ID allowed to assign clans. Members with this role or any role
# above it in the server role hierarchy can use /clan assign.
CLAN_MANAGER_ROLE_ID=1492957184261230642

# Discord Head Administrator role ID. Members with this role or any role above
# it can configure the ticket system.
HEAD_ADMIN_ROLE_ID=1492957184261230642

# Optional: cache Roblox lookups for this many seconds.
CACHE_TTL_SECONDS=300
